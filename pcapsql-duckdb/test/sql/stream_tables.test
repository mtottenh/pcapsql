8	8	443	TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256	true

# HTTP/1.1 inside TLS is in http_messages, as HTTP/1.1 in the clear is
query TTTT
SELECT version, cipher_suite, alpn, is_decrypted
FROM read_tls_sessions('../pcapsql-testgen/fixtures/tls12_http1.pcap', keylog := '../pcapsql-testgen/fixtures/tls12_http1.keys');
----
TLS 1.2	TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256	http/1.1	true

query IIITTTTTTITIT
SELECT frame_number, connection_id, message_id, direction, is_request, method, uri, http_version, host, status_code,
       content_type, content_length, user_agent
FROM read_http_messages('../pcapsql-testgen/fixtures/tls12_http1.pcap', keylog := '../pcapsql-testgen/fixtures/tls12_http1.keys');
----
8	1	0	to_server	true	GET	/index.html	HTTP/1.1	example.test	NULL	NULL	NULL	pcapsql-corpus/1.0
10	1	0	to_client	false	NULL	NULL	HTTP/1.1	NULL	200	text/plain	5	NULL

query II
SELECT (SELECT count(*) FROM read_http_messages('../pcapsql-testgen/fixtures/tls12_http1.pcap')),
       (SELECT count(*) FROM read_http2('../pcapsql-testgen/fixtures/tls12_http1.pcap', keylog := '../pcapsql-testgen/fixtures/tls12_http1.keys'));
----
0	0

query III
SELECT count(*), count(c.connection_id), bool_and(s.is_decrypted)
FROM read_pcap('../pcapsql-testgen/fixtures/tls12_http1.pcap', protocol := 'http_messages', keylog := '../pcapsql-testgen/fixtures/tls12_http1.keys') h
LEFT JOIN read_tcp_connections('../pcapsql-testgen/fixtures/tls12_http1.pcap') c USING (connection_id)
LEFT JOIN read_tls_sessions('../pcapsql-testgen/fixtures/tls12_http1.pcap', keylog := '../pcapsql-testgen/fixtures/tls12_http1.keys') s USING (connection_id);
----
2	2	true

# The key log of another session decrypts nothing
query TI
SELECT is_decrypted, (SELECT count(*) FROM read_http2('../pcapsql-testgen/fixtures/tls12_http2.pcap', keylog := '../pcapsql-testgen/fixtures/tls13_http2.keys'))
FROM read_tls_sessions('../pcapsql-testgen/fixtures/tls12_http2.pcap', keylog := '../pcapsql-testgen/fixtures/tls13_http2.keys');
----
false	0

# The packet table has a row for the records that are encrypted: the header, and for
# application data its length. Frame 11 is the start of a record that ends in frame 12
query IITIIII
SELECT frame_number, record_type, version, handshake_type, has_app_data::INT, app_data_length, alert_level
FROM read_tls('../pcapsql-testgen/fixtures/tls12_http2.pcap');
----
4	22	TLS 1.0	1	NULL	NULL	NULL
5	22	TLS 1.2	2	NULL	NULL	NULL
6	22	TLS 1.2	16	NULL	NULL	NULL
7	20	TLS 1.2	NULL	NULL	NULL	NULL
8	23	TLS 1.2	NULL	1	57	NULL
9	23	TLS 1.2	NULL	1	33	NULL
10	23	TLS 1.2	NULL	1	79	NULL
11	23	TLS 1.2	NULL	NULL	NULL	NULL
13	23	TLS 1.2	NULL	1	41	NULL
14	21	TLS 1.2	NULL	NULL	NULL	NULL

# A capture without a link layer (LINKTYPE_IPV4, with its secrets in Decryption Secrets
# Blocks, which are not read): its connections and its sessions
query IITITT
SELECT c.connection_id, c.first_frame, c.server_ip, c.server_port, s.sni, s.cipher_suite
FROM read_tcp_connections('../fuzz/corpus/fuzz_pcap_reader/tls12-dsb.pcapng') c
JOIN read_tls_sessions('../fuzz/corpus/fuzz_pcap_reader/tls12-dsb.pcapng') s USING (connection_id) ORDER BY 1;
----
1	1	93.184.216.34	443	example.com	TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256
2	10	93.184.216.34	443	example.net	TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256

# A capture the key log has no session of is read as without one
query I
SELECT count(*) FROM read_http2('../fuzz/corpus/fuzz_pcap_reader/http.pcap', keylog := '../pcapsql-testgen/fixtures/tls13_http2.keys');
----
0

# The setting is the key log of a call that names none: a view, for one
statement ok
CREATE VIEW http2 AS SELECT * FROM read_http2('../pcapsql-testgen/fixtures/tls13_http2.pcap');

query T
SELECT current_setting('pcapsql_keylog');
----
(empty)

query I
SELECT count(*) FROM http2;
----
0

statement ok
SET pcapsql_keylog = '../pcapsql-testgen/fixtures/tls13_http2.keys';

query I
SELECT count(*) FROM http2;
----
8

query T
SELECT is_decrypted FROM read_tls_sessions('../pcapsql-testgen/fixtures/tls13_http2.pcap');
----
true

# The parameter wins over the setting: an empty one reads without a key log, NULL is "not given"
query T
SELECT is_decrypted FROM read_tls_sessions('../pcapsql-testgen/fixtures/tls13_http2.pcap', keylog := '');
----
false

query T
SELECT is_decrypted FROM read_tls_sessions('../pcapsql-testgen/fixtures/tls13_http2.pcap', keylog := NULL);
----
true

statement error
SELECT * FROM read_tls_sessions('../pcapsql-testgen/fixtures/tls13_http2.pcap', keylog := 'nope.keys');
----
read_tls_sessions: cannot open the key log 'nope.keys'

# The replacement scan is unchanged: a capture named as a table is its frames
query II
SELECT count(*), max(frame_number) FROM '../pcapsql-testgen/fixtures/tls13_http2.pcap';
----
16	16

# A setting that names no key log fails the scans of stream tables, and says where the path
# is from; the parameter still wins, and scans of packet tables do not read it
statement ok
SET pcapsql_keylog = '../pcapsql-testgen/Cargo.toml';

statement error
SELECT count(*) FROM http2;
----
read_http2: '../pcapsql-testgen/Cargo.toml' (the setting pcapsql_keylog) is not a TLS key log pcapsql can read (NSS key log format, the file SSLKEYLOGFILE names): line 1: expected 3 space-separated fields, got 1

query I
SELECT count(*) FROM read_http2('../pcapsql-testgen/fixtures/tls13_http2.pcap', keylog := '../pcapsql-testgen/fixtures/tls13_http2.keys');
----
8

query I
SELECT count(*) FROM read_tcp('../pcapsql-testgen/fixtures/tls13_http2.pcap');
----
16

statement ok
RESET pcapsql_keylog;

query I
SELECT count(*) FROM http2;
----
0

statement error
SET pcapsql_keylog = NULL;
----
pcapsql_keylog must not be NULL

# A file that is not a key log: the message has its path and what is wrong, not its content
statement error
SELECT * FROM read_http2('../pcapsql-testgen/fixtures/tls13_http2.pcap', keylog := '../pcapsql-testgen/fixtures/tls13_http2.pcap');
----
read_http2: '../pcapsql-testgen/fixtures/tls13_http2.pcap' is not a TLS key log pcapsql can read (NSS key log format, the file SSLKEYLOGFILE names): stream did not contain valid UTF-8

# keylog is a parameter of the stream functions and of read_pcap, which ignores it (and does
# not open the file) when it reads a packet table or a view
statement error
SELECT * FROM read_tcp('../pcapsql-testgen/fixtures/tls13_http2.pcap', keylog := '../pcapsql-testgen/fixtures/tls13_http2.keys');
----
keylog

statement error
SELECT * FROM read_tls_packets('../pcapsql-testgen/fixtures/tls13_http2.pcap', keylog := '../pcapsql-testgen/fixtures/tls13_http2.keys');
----
keylog

query I
SELECT count(*) FROM read_pcap('../pcapsql-testgen/fixtures/tls13_http2.pcap', protocol := 'tls', keylog := 'nope.keys');
----
10

query I
SELECT count(*) FROM read_pcap('../pcapsql-testgen/fixtures/tls13_http2.pcap', keylog := 'nope.keys');
----
16

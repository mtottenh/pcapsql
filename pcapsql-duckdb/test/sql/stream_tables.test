# name: test/sql/stream_tables.test
# description: the stream tables (tcp_connections, tls_sessions, http_messages, http2) and the TLS key log
# group: [pcapsql]

# The in-process tests (itest/tests/stream_tables.rs) compare every stream table with the
# shared scan layer cell by cell; this file checks the built artifact: the functions, their
# rows over real captures (the seeds of the reader fuzzer) and over the generated TLS 1.3 and TLS 1.2
# captures with their key logs (pcapsql-testgen/fixtures), the keylog parameter and the
# pcapsql_keylog setting. Paths are relative to pcapsql-duckdb/.

statement error
SELECT * FROM read_tcp_connections('../fuzz/corpus/fuzz_pcap_reader/http.pcap');
----
read_tcp_connections

require pcapsql

# One function per stream table, with keylog after the parameters every scan function has
query TTT
SELECT function_name, parameters, parameter_types FROM duckdb_functions()
WHERE function_name IN (SELECT 'read_' || name FROM pcap_protocols() WHERE kind = 'stream')
ORDER BY function_name;
----
read_http2	[files, strict, filename, keylog]	[ANY, BOOLEAN, BOOLEAN, VARCHAR]
read_http_messages	[files, strict, filename, keylog]	[ANY, BOOLEAN, BOOLEAN, VARCHAR]
read_tcp_connections	[files, strict, filename, keylog]	[ANY, BOOLEAN, BOOLEAN, VARCHAR]
read_tls_sessions	[files, strict, filename, keylog]	[ANY, BOOLEAN, BOOLEAN, VARCHAR]

query TI
SELECT name, field_count FROM pcap_protocols() WHERE kind = 'stream' ORDER BY name;
----
http2	34
http_messages	17
tcp_connections	20
tls_sessions	12

# The columns are those of pcap_schema, through either function
query I
SELECT count(*) FROM (
    SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM read_tcp_connections('../fuzz/corpus/fuzz_pcap_reader/http.pcap'))
    EXCEPT SELECT column_name, column_type FROM pcap_schema('tcp_connections'));
----
0

query I
SELECT count(*) FROM (
    SELECT column_name, column_type FROM pcap_schema('http2')
    EXCEPT SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM read_pcap('../fuzz/corpus/fuzz_pcap_reader/http.pcap', protocol := 'http2')));
----
0

# A connection: its endpoints, the frames it spans, what it carried
query IITTIITIIIIIIT
SELECT frame_number, connection_id, client_ip, server_ip, client_port, server_port, state, first_frame, last_frame,
       packets_to_server, packets_to_client, bytes_to_server, bytes_to_client, is_complete
FROM read_tcp_connections('../fuzz/corpus/fuzz_pcap_reader/http.pcap');
----
1	1	10.0.0.5	207.46.134.94	3267	80	established	1	1	1	0	153	0	false

query IITTIT
SELECT frame_number, connection_id, client_ip, server_port, state, is_complete
FROM read_pcap('../fuzz/corpus/fuzz_pcap_reader/v6-http.cap', protocol := 'tcp_connections');
----
46	1	2001:6f8:102d:0:2d0:9ff:fee3:e8de	80	last_ack	false

# HTTP/1.x messages, reassembled: the response of this capture spans twenty frames
query IITTTIT
SELECT frame_number, connection_id, direction, method, uri, status_code, content_type
FROM read_http_messages('../fuzz/corpus/fuzz_pcap_reader/http-chunked-gzip.pcap');
----
4	1	to_server	GET	/	NULL	NULL
24	1	to_client	NULL	NULL	200	text/html

# A stream table joins a packet table on frame_number, and another stream table on connection_id
query ITII
SELECT m.frame_number, m.method, t.dst_port, c.client_port
FROM read_http_messages('../fuzz/corpus/fuzz_pcap_reader/http-chunked-gzip.pcap') m
JOIN read_tcp('../fuzz/corpus/fuzz_pcap_reader/http-chunked-gzip.pcap') t USING (frame_number)
JOIN read_tcp_connections('../fuzz/corpus/fuzz_pcap_reader/http-chunked-gzip.pcap') c USING (connection_id)
WHERE m.method IS NOT NULL;
----
4	GET	8080	33412

# Projection, a row count, filters (DuckDB applies them to the rows of a full scan), LIMIT
query TI
SELECT state, server_port FROM read_tcp_connections('../fuzz/corpus/fuzz_pcap_reader/v6-http.cap');
----
last_ack	80

query I
SELECT count(*) FROM read_http_messages('../fuzz/corpus/fuzz_pcap_reader/v6-http.cap');
----
2

query IT
SELECT frame_number, direction FROM read_http_messages('../fuzz/corpus/fuzz_pcap_reader/v6-http.cap') WHERE frame_number > 49;
----
51	to_client

query I
SELECT count(*) FROM read_http_messages('../fuzz/corpus/fuzz_pcap_reader/v6-http.cap') WHERE frame_number < 1;
----
0

query I
SELECT frame_number FROM read_http_messages('../fuzz/corpus/fuzz_pcap_reader/v6-http.cap') WHERE frame_number BETWEEN 40 AND 50;
----
49

query I
SELECT frame_number FROM read_http_messages('../fuzz/corpus/fuzz_pcap_reader/v6-http.cap') LIMIT 1;
----
49

# Several files: a pattern, a list. Connections are numbered within a file, so the file
# tells them apart
query TII
SELECT parse_filename(filename), count(*), max(connection_id)
FROM read_tcp_connections('../fuzz/corpus/fuzz_pcap_reader/*', filename := true)
GROUP BY ALL ORDER BY 1;
----
gre_keyed.pcap	5	5
http-chunked-gzip.pcap	1	1
http.pcap	1	1
http_gzip.cap	1	1
ldap-ssl.pcapng	1	1
tcp-ecn-sample.pcap	1	1
tls12-dsb.pcapng	2	2
v6-http.cap	1	1
v6.pcap	1	1
vxlan_simple.pcap	5	5

query TI
SELECT parse_filename(filename), count(*)
FROM read_http_messages(['../fuzz/corpus/fuzz_pcap_reader/v6-http.cap', '../fuzz/corpus/fuzz_pcap_reader/http*'], filename := true)
GROUP BY ALL ORDER BY min(filename) DESC;
----
v6-http.cap	2
http_gzip.cap	2
http.pcap	1
http-chunked-gzip.pcap	2

query III
SELECT count(*), count(DISTINCT connection_id), count(DISTINCT (filename, connection_id))
FROM read_tcp_connections('../fuzz/corpus/fuzz_pcap_reader/*', filename := true);
----
19	5	19

# The settings that split a packet table's capture do not split a stream table's
statement ok
SET threads = 4;

statement ok
SET pcapsql_parallel_min_file_size = 0;

statement ok
SET pcapsql_index_stride = 4;

query III
SELECT count(*), min(frame_number), max(frame_number) FROM read_http_messages('../fuzz/corpus/fuzz_pcap_reader/http-chunked-gzip.pcap');
----
2	4	24

query II
SELECT count(*), sum(connection_id) FROM read_tcp_connections('../fuzz/corpus/fuzz_pcap_reader/*');
----
19	40

statement ok
RESET threads;

statement ok
RESET pcapsql_parallel_min_file_size;

statement ok
RESET pcapsql_index_stride;

# strict: a whole capture passes (itest/tests/stream_tables.rs has one cut off inside a
# record, which fails)
query I
SELECT count(*) FROM read_tcp_connections('../fuzz/corpus/fuzz_pcap_reader/http.pcap', strict := true);
----
1

# Files that cannot be read
statement error
SELECT * FROM read_tls_sessions('../fuzz/corpus/fuzz_pcap_reader/nope.pcap');
----
nope.pcap

statement error
SELECT * FROM read_http2('Makefile');
----
read_http2: 'Makefile' is not a capture file

statement error
SELECT * FROM read_http_messages('../fuzz/corpus/fuzz_pcap_reader/*.nope');
----
read_http_messages: no file matches the pattern

# TLS: without a key log, the handshake's metadata and no HTTP/2
query IITTITTTI
SELECT frame_number, connection_id, version, cipher_suite, cipher_suite_id, sni, alpn, is_decrypted, server_hello_frame
FROM read_tls_sessions('../pcapsql-testgen/fixtures/tls13_http2.pcap');
----
4	1	TLS 1.3	TLS_AES_128_GCM_SHA256	4865	example.test	h2	false	5

query I
SELECT count(*) FROM read_http2('../pcapsql-testgen/fixtures/tls13_http2.pcap');
----
0

# With the key log the session is decrypted, and HTTP/2 is what it carried
query ITT
SELECT frame_number, version, is_decrypted
FROM read_tls_sessions('../pcapsql-testgen/fixtures/tls13_http2.pcap', keylog := '../pcapsql-testgen/fixtures/tls13_http2.keys');
----
4	TLS 1.3	true

query IITIIITTTTITITIT
SELECT frame_number, connection_id, frame_type, stream_id, flags, length, method, path, authority, scheme, status,
       content_type, content_length, user_agent, data_length, end_stream
FROM read_http2('../pcapsql-testgen/fixtures/tls13_http2.pcap', keylog := '../pcapsql-testgen/fixtures/tls13_http2.keys');
----
8	1	SETTINGS	0	0	0	NULL	NULL	NULL	NULL	NULL	NULL	NULL	NULL	NULL	NULL
9	1	SETTINGS	0	0	0	NULL	NULL	NULL	NULL	NULL	NULL	NULL	NULL	NULL	NULL
10	1	SETTINGS	0	1	0	NULL	NULL	NULL	NULL	NULL	NULL	NULL	NULL	NULL	NULL
10	1	HEADERS	1	5	37	GET	/	example.test	https	NULL	NULL	NULL	pcapsql-corpus/1.0	NULL	true
11	1	SETTINGS	0	1	0	NULL	NULL	NULL	NULL	NULL	NULL	NULL	NULL	NULL	NULL
11	1	HEADERS	1	4	16	NULL	NULL	NULL	NULL	200	text/plain	5	NULL	NULL	false
12	1	DATA	1	1	5	NULL	NULL	NULL	NULL	NULL	NULL	NULL	NULL	5	true
13	1	GOAWAY	0	0	8	NULL	NULL	NULL	NULL	NULL	NULL	NULL	NULL	NULL	NULL

query I
SELECT count(*) FROM read_pcap('../pcapsql-testgen/fixtures/tls13_http2.pcap', protocol := 'http2', keylog := '../pcapsql-testgen/fixtures/tls13_http2.keys');
----
8

# http2.connection_id is the connection of tcp_connections and tls_sessions: every frame joins
query IIITT
SELECT count(*), count(c.connection_id), any_value(c.server_port), any_value(s.sni), bool_and(s.is_decrypted)
FROM read_http2('../pcapsql-testgen/fixtures/tls13_http2.pcap', keylog := '../pcapsql-testgen/fixtures/tls13_http2.keys') h
LEFT JOIN read_tcp_connections('../pcapsql-testgen/fixtures/tls13_http2.pcap') c USING (connection_id)
LEFT JOIN read_tls_sessions('../pcapsql-testgen/fixtures/tls13_http2.pcap', keylog := '../pcapsql-testgen/fixtures/tls13_http2.keys') s USING (connection_id);
----
8	8	443	example.test	true

# TLS 1.2 (TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256): the same without a key log
query IITTITTTI
SELECT frame_number, connection_id, version, cipher_suite, cipher_suite_id, sni, alpn, is_decrypted, server_hello_frame
FROM read_tls_sessions('../pcapsql-testgen/fixtures/tls12_http2.pcap');
----
4	1	TLS 1.2	TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256	49199	example.test	h2	false	5

query II
SELECT (SELECT count(*) FROM read_http2('../pcapsql-testgen/fixtures/tls12_http2.pcap')), (SELECT count(*) FROM read_http_messages('../pcapsql-testgen/fixtures/tls12_http2.pcap'));
----
0	0

# and with it: the records after each side's ChangeCipherSpec are decrypted, its Finished
# first. The response is two records in the segments 11 and 12, with the DATA frame in both
query ITT
SELECT frame_number, version, is_decrypted
FROM read_tls_sessions('../pcapsql-testgen/fixtures/tls12_http2.pcap', keylog := '../pcapsql-testgen/fixtures/tls12_http2.keys');
----
4	TLS 1.2	true

query IITIIITTTTITITIT
SELECT frame_number, connection_id, frame_type, stream_id, flags, length, method, path, authority, scheme, status,
       content_type, content_length, user_agent, data_length, end_stream
FROM read_http2('../pcapsql-testgen/fixtures/tls12_http2.pcap', keylog := '../pcapsql-testgen/fixtures/tls12_http2.keys');
----
8	1	SETTINGS	0	0	0	NULL	NULL	NULL	NULL	NULL	NULL	NULL	NULL	NULL	NULL
9	1	SETTINGS	0	0	0	NULL	NULL	NULL	NULL	NULL	NULL	NULL	NULL	NULL	NULL
10	1	SETTINGS	0	1	0	NULL	NULL	NULL	NULL	NULL	NULL	NULL	NULL	NULL	NULL
10	1	HEADERS	1	5	37	GET	/	example.test	https	NULL	NULL	NULL	pcapsql-corpus/1.0	NULL	true
12	1	SETTINGS	0	1	0	NULL	NULL	NULL	NULL	NULL	NULL	NULL	NULL	NULL	NULL
12	1	HEADERS	1	4	16	NULL	NULL	NULL	NULL	200	text/plain	5	NULL	NULL	false
12	1	DATA	1	1	5	NULL	NULL	NULL	NULL	NULL	NULL	NULL	NULL	5	true
13	1	GOAWAY	0	0	8	NULL	NULL	NULL	NULL	NULL	NULL	NULL	NULL	NULL	NULL

query IIITT
SELECT count(*), count(c.connection_id), any_value(c.server_port), any_value(s.cipher_suite), bool_and(s.is_decrypted)
FROM read_http2('../pcapsql-testgen/fixtures/tls12_http2.pcap', keylog := '../pcapsql-testgen/fixtures/tls12_http2.keys') h
LEFT JOIN read_tcp_connections('../pcapsql-testgen/fixtures/tls12_http2.pcap') c USING (connection_id)
LEFT JOIN read_tls_sessions('../pcapsql-testgen/fixtures/tls12_http2.pcap', keylog := '../pcapsql-testgen/fixtures/tls12_http2.keys') s USING (connection_id);

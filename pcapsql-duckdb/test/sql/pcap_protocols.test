# name: test/sql/pcap_protocols.test
# description: pcap_protocols() lists the protocol tables of the extension
# group: [pcapsql]

statement error
SELECT * FROM pcap_protocols();
----
pcap_protocols

require pcapsql

query TT
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM pcap_protocols());
----
name	VARCHAR
description	VARCHAR
field_count	UINTEGER
kind	VARCHAR

# frames and the 27 protocol tables of the shared catalogue
query I
SELECT count(*) FROM pcap_protocols();
----
28

query TTIT
SELECT name, description, field_count, kind FROM pcap_protocols() WHERE name = 'frames';
----
frames	Raw frame metadata (timestamp, length, etc.)	6	frames

query TT
SELECT name, description FROM pcap_protocols() WHERE name IN ('dns', 'ethernet', 'ipv6', 'tcp', 'tls');
----
dns	Domain Name System
ethernet	Ethernet II frames (Layer 2)
ipv6	Internet Protocol version 6
tcp	Transmission Control Protocol
tls	Transport Layer Security

# Rows come back sorted by name
query I
SELECT list(name) = list_sort(list(name)) FROM pcap_protocols();
----
true

query I
SELECT count(*) FROM pcap_protocols() WHERE field_count = 0 OR description = '';
----
0

# One frames table; every other table holds the layers of one protocol
query TI
SELECT kind, count(*) FROM pcap_protocols() GROUP BY kind ORDER BY kind;
----
frames	1
protocol	27

# The stream tables of the catalogue are not read by the extension yet
query I
SELECT count(*) FROM pcap_protocols() WHERE name IN ('tcp_connections', 'tls_sessions', 'http_messages', 'http2');
----
0

# field_count is the number of columns pcap_schema() lists
query II
SELECT field_count, (SELECT count(*) FROM pcap_schema('ethernet')) FROM pcap_protocols() WHERE name = 'ethernet';
----
8	8

query I
SELECT field_count = (SELECT count(*) FROM pcap_schema('dns')) FROM pcap_protocols() WHERE name = 'dns';
----
true

# The function takes no arguments
statement error
SELECT * FROM pcap_protocols('tcp');
----
pcap_protocols

# Two scans of the function in one query are independent
query I
SELECT count(*) FROM pcap_protocols() a JOIN pcap_protocols() b USING (name);
----
28
